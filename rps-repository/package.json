{
  "name": "trinity-afterlight",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-reflections.mjs --check && vite build",
    "build:models": "blender --background --python scripts/build_fighters.py && node scripts/pack_fighters.mjs && node scripts/build-reflections.mjs",
    "build:reflections": "node scripts/build-reflections.mjs",
    "build:static": "node scripts/build-static.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "server": "node --use-env-proxy --env-file-if-exists=.env server/index.js",
    "start": "npm run server",
    "balance": "node scripts/balance.mjs",
    "proof": "node scripts/choreography-proof.mjs",
    "capture:attacks": "node scripts/capture-choreography.mjs",
    "simulate": "node scripts/run-simulation.mjs"
  },
  "devDependencies": {
    "gltfpack": "1.3.0",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.5.0"
  }
}
